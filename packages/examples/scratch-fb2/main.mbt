fn main raise {
  let renderer = @core.Renderer::create(background="#0a0a1e")
  let root = renderer.root()
  let frame_w = renderer.get_width()
  let frame_h = renderer.get_height()
  let a = @core.new_framebuffer(renderer, width=frame_w, height=frame_h, position="absolute", top="0")
  let a_fb = @core.framebuffer_of(renderer, a)
  root.add(a)
  let b = @core.new_framebuffer(renderer, width=frame_w, height=frame_h, position="absolute", top="0")
  let b_fb = @core.framebuffer_of(renderer, b)
  root.add(b)
  a_fb.draw_text(text="AAA layer", x=0, y=0, fg="#2a2a4e", bg=Some("#0a0a1e"))
  b_fb.draw_text(text="BBB layer", x=0, y=1, fg="#e6edf3", bg=Some("#0a0a1e"))
  renderer.render()
  renderer.render()
  renderer.stop()
}
