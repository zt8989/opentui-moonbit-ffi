// tiny 字体字模（提取自 vendor/opentui core lib/fonts/tiny.json，cfonts 格式）：
// 每个字符 2 行半块字符画，letterspace 1 列。

pub fn tiny_font() -> Map[String, Array[String]] {
  let m : Map[String, Array[String]] = Map::new()
  m[" "] = [" ", " "]
  m["!"] = ["█", "▄"]
  m["-"] = ["▄▄", "  "]
  m["."] = [" ", "▄"]
  m[":"] = ["▀", "▄"]
  m["?"] = ["▀█", " ▄"]
  m["A"] = ["▄▀█", "█▀█"]
  m["B"] = ["█▄▄", "█▄█"]
  m["C"] = ["█▀▀", "█▄▄"]
  m["D"] = ["█▀▄", "█▄▀"]
  m["E"] = ["█▀▀", "██▄"]
  m["F"] = ["█▀▀", "█▀ "]
  m["G"] = ["█▀▀", "█▄█"]
  m["H"] = ["█ █", "█▀█"]
  m["I"] = ["█", "█"]
  m["J"] = ["  █", "█▄█"]
  m["K"] = ["█▄▀", "█ █"]
  m["L"] = ["█  ", "█▄▄"]
  m["M"] = ["█▀▄▀█", "█ ▀ █"]
  m["N"] = ["█▄ █", "█ ▀█"]
  m["O"] = ["█▀█", "█▄█"]
  m["P"] = ["█▀█", "█▀▀"]
  m["Q"] = ["█▀█", "▀▀█"]
  m["R"] = ["█▀█", "█▀▄"]
  m["S"] = ["█▀▀", "▄▄█"]
  m["T"] = ["▀█▀", " █ "]
  m["U"] = ["█ █", "█▄█"]
  m["V"] = ["█ █", "▀▄▀"]
  m["W"] = ["█ █ █", "▀▄▀▄▀"]
  m["X"] = ["▀▄▀", "█ █"]
  m["Y"] = ["█▄█", " █ "]
  m["Z"] = ["▀█", "█▄"]
  m
}
